# Virtual environment
.venv/

# Generated data (recreated by running the pipeline) - keep the folders, ignore contents
input/*
output/*
reports/*
dropped_and_dupes/*
!input/.gitkeep
!output/.gitkeep
!reports/.gitkeep
!dropped_and_dupes/.gitkeep

# Sync the to_upload folder, but ignore the CSV files inside it
!output/to_upload/
!output/to_upload/.gitkeep
output/to_upload/*.csv

